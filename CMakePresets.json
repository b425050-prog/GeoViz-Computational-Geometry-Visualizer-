{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "GeoViz Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GEOVIZ_BUILD_APP": "ON",
        "GEOVIZ_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "GeoViz Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GEOVIZ_BUILD_APP": "ON",
        "GEOVIZ_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "core-only",
      "displayName": "Algorithms and tests only",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GEOVIZ_BUILD_APP": "OFF",
        "GEOVIZ_BUILD_TESTS": "ON",
        "GEOVIZ_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "core-only", "configurePreset": "core-only" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "output": { "outputOnFailure": true }
    }
  ]
}

